  47:Core/Src/tetris.c **** static void refill_bag(void) {
  48:Core/Src/tetris.c ****     for (uint8_t i = 0; i < PIECE_COUNT; i++) {
  49:Core/Src/tetris.c ****         piece_bag[i] = i;
  50:Core/Src/tetris.c ****     }
  51:Core/Src/tetris.c **** 
  52:Core/Src/tetris.c ****     for (int i = PIECE_COUNT - 1; i > 0; i--) {
  53:Core/Src/tetris.c ****         int j = rand() % (i + 1);
  54:Core/Src/tetris.c ****         uint8_t tmp = piece_bag[i];
  55:Core/Src/tetris.c ****         piece_bag[i] = piece_bag[j];
  56:Core/Src/tetris.c ****         piece_bag[j] = tmp;
  57:Core/Src/tetris.c ****     }
  58:Core/Src/tetris.c **** 
  59:Core/Src/tetris.c ****     bag_index = 0;
  60:Core/Src/tetris.c **** }
  61:Core/Src/tetris.c **** 
  62:Core/Src/tetris.c **** static uint8_t draw_from_bag(void) {
  63:Core/Src/tetris.c ****     if (bag_index >= PIECE_COUNT) {
  64:Core/Src/tetris.c ****         refill_bag();
  65:Core/Src/tetris.c ****     }
  66:Core/Src/tetris.c **** 
  67:Core/Src/tetris.c ****     return piece_bag[bag_index++];
  68:Core/Src/tetris.c **** }
