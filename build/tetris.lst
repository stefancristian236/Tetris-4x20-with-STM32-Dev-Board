 256:Core/Src/tetris.c **** void Tetris_Update(TetrisCommand cmd) {
 257:Core/Src/tetris.c ****     if (cmd == CMD_RESTART) {
 258:Core/Src/tetris.c ****         Tetris_Init();
 259:Core/Src/tetris.c ****         return;
 260:Core/Src/tetris.c ****     }
 261:Core/Src/tetris.c **** 
 262:Core/Src/tetris.c ****     if (cmd == CMD_PAUSE) {
 263:Core/Src/tetris.c ****         if (!game_over) {
 264:Core/Src/tetris.c ****             paused = !paused;
 265:Core/Src/tetris.c ****         }
 266:Core/Src/tetris.c ****         return;
 267:Core/Src/tetris.c ****     }
 268:Core/Src/tetris.c **** 
 269:Core/Src/tetris.c ****     if (game_over || paused) {
 270:Core/Src/tetris.c ****         return;
 271:Core/Src/tetris.c ****     }
 272:Core/Src/tetris.c **** 
 273:Core/Src/tetris.c ****     switch (cmd) {
 274:Core/Src/tetris.c ****         case CMD_LEFT:
 275:Core/Src/tetris.c ****             move_piece(-1, 0);
 276:Core/Src/tetris.c ****             break;
 277:Core/Src/tetris.c ****         case CMD_RIGHT:
 278:Core/Src/tetris.c ****             move_piece(1, 0);
 279:Core/Src/tetris.c ****             break;
 280:Core/Src/tetris.c ****         case CMD_DOWN:  
 281:Core/Src/tetris.c ****             if (move_piece(0, 1)) {
 282:Core/Src/tetris.c ****                 score += SOFT_DROP_POINTS;
 283:Core/Src/tetris.c ****             } else {
 284:Core/Src/tetris.c ****                 lock_piece();
 285:Core/Src/tetris.c ****             }
 286:Core/Src/tetris.c ****             break;
 287:Core/Src/tetris.c ****         case CMD_FALL:
 288:Core/Src/tetris.c ****             if (!move_piece(0, 1)) {
 289:Core/Src/tetris.c ****                 lock_piece();
 290:Core/Src/tetris.c ****             }
 291:Core/Src/tetris.c ****             break;
 292:Core/Src/tetris.c ****         case CMD_ROTATE: 
 293:Core/Src/tetris.c ****             rotate_piece();
 294:Core/Src/tetris.c ****             break;
 295:Core/Src/tetris.c ****         case CMD_HARD_DROP: {
 296:Core/Src/tetris.c ****             uint8_t distance = drop_distance();
 297:Core/Src/tetris.c ****             piece_y += distance;
 298:Core/Src/tetris.c ****             score += (uint32_t)distance * HARD_DROP_POINTS;
 299:Core/Src/tetris.c ****             lock_piece();
 300:Core/Src/tetris.c ****             break;
 301:Core/Src/tetris.c ****         }
 302:Core/Src/tetris.c ****         case CMD_NONE: default: break;
 303:Core/Src/tetris.c ****     }
ARM GAS  C:\Users\crist\AppData\Local\Temp\ccWhY2jg.s 			page 20


 304:Core/Src/tetris.c **** }
