 285:Core/Src/tetris.c **** uint32_t Tetris_GetFallDelay(void) {
 286:Core/Src/tetris.c ****     uint32_t reduction = (uint32_t)(level - 1U) * 45U;
 287:Core/Src/tetris.c **** 
 288:Core/Src/tetris.c ****     if (reduction >= (FALL_DELAY_MS - MIN_FALL_DELAY_MS)) {
 289:Core/Src/tetris.c ****         return MIN_FALL_DELAY_MS;
 290:Core/Src/tetris.c ****     }
 291:Core/Src/tetris.c **** 
 292:Core/Src/tetris.c ****     return FALL_DELAY_MS - reduction;
 293:Core/Src/tetris.c **** }
