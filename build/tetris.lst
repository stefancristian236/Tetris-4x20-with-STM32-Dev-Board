 221:Core/Src/tetris.c **** 
 222:Core/Src/tetris.c **** void Tetris_Update(TetrisCommand cmd) {
 223:Core/Src/tetris.c ****     if (cmd == CMD_RESTART) {
 224:Core/Src/tetris.c ****         Tetris_Init();
 225:Core/Src/tetris.c ****         return;
 226:Core/Src/tetris.c ****     }
 227:Core/Src/tetris.c **** 
 228:Core/Src/tetris.c ****     if (cmd == CMD_PAUSE) {
 229:Core/Src/tetris.c ****         if (!game_over) {
 230:Core/Src/tetris.c ****             paused = !paused;
 231:Core/Src/tetris.c ****         }
 232:Core/Src/tetris.c ****         return;
 233:Core/Src/tetris.c ****     }
 234:Core/Src/tetris.c **** 
 235:Core/Src/tetris.c ****     if (game_over || paused) {
 236:Core/Src/tetris.c ****         return;
 237:Core/Src/tetris.c ****     }
 238:Core/Src/tetris.c **** 
 239:Core/Src/tetris.c ****     switch (cmd) {
 240:Core/Src/tetris.c ****         case CMD_LEFT:
 241:Core/Src/tetris.c ****             move_piece(-1, 0);
 242:Core/Src/tetris.c ****             break;
 243:Core/Src/tetris.c ****         case CMD_RIGHT:
 244:Core/Src/tetris.c ****             move_piece(1, 0);
 245:Core/Src/tetris.c ****             break;
 246:Core/Src/tetris.c ****         case CMD_DOWN:  
 247:Core/Src/tetris.c ****             if (move_piece(0, 1)) {
 248:Core/Src/tetris.c ****                 score += SOFT_DROP_POINTS;
 249:Core/Src/tetris.c ****             } else {
 250:Core/Src/tetris.c ****                 lock_piece();
 251:Core/Src/tetris.c ****             }
 252:Core/Src/tetris.c ****             break;
 253:Core/Src/tetris.c ****         case CMD_FALL:
ARM GAS  C:\Users\crist\AppData\Local\Temp\cccMhL3t.s 			page 16


 254:Core/Src/tetris.c ****             if (!move_piece(0, 1)) {
 255:Core/Src/tetris.c ****                 lock_piece();
 256:Core/Src/tetris.c ****             }
 257:Core/Src/tetris.c ****             break;
 258:Core/Src/tetris.c ****         case CMD_ROTATE: 
 259:Core/Src/tetris.c ****             rotate_piece();
 260:Core/Src/tetris.c ****             break;
 261:Core/Src/tetris.c ****         case CMD_HARD_DROP: {
 262:Core/Src/tetris.c ****             uint8_t distance = drop_distance();
 263:Core/Src/tetris.c ****             piece_y += distance;
 264:Core/Src/tetris.c ****             score += (uint32_t)distance * HARD_DROP_POINTS;
 265:Core/Src/tetris.c ****             lock_piece();
