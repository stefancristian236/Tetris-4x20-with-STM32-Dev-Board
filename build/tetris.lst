  96:Core/Src/tetris.c **** static uint8_t clear_full_lines(void) {
  97:Core/Src/tetris.c ****     uint8_t cleared = 0;
  98:Core/Src/tetris.c **** 
  99:Core/Src/tetris.c ****     for (int y = BOARD_H - 1; y >= 0; y--) {
 100:Core/Src/tetris.c ****         bool full = true;
 101:Core/Src/tetris.c **** 
 102:Core/Src/tetris.c ****         for (int x = 0; x < BOARD_W; x++) {
 103:Core/Src/tetris.c ****             if (!board[y][x]) {
 104:Core/Src/tetris.c ****                 full = false;
 105:Core/Src/tetris.c ****                 break;
 106:Core/Src/tetris.c ****             }
 107:Core/Src/tetris.c ****         }
 108:Core/Src/tetris.c **** 
 109:Core/Src/tetris.c ****         if (full) {
 110:Core/Src/tetris.c ****             for (int r = y; r > 0; r--) {
 111:Core/Src/tetris.c ****                 memcpy(board[r], board[r - 1], BOARD_W);
 112:Core/Src/tetris.c ****             }
 113:Core/Src/tetris.c ****             memset(board[0], 0, BOARD_W);
 114:Core/Src/tetris.c ****             cleared++;
 115:Core/Src/tetris.c ****             y++;
 116:Core/Src/tetris.c ****         }
 117:Core/Src/tetris.c ****     }
