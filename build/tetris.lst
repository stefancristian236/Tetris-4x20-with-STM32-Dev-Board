 319:Core/Src/tetris.c **** uint32_t Tetris_GetFallDelay(void) {
 320:Core/Src/tetris.c ****     uint32_t reduction = (uint32_t)(level - 1U) * 45U;
 321:Core/Src/tetris.c **** 
 322:Core/Src/tetris.c ****     if (reduction >= (FALL_DELAY_MS - MIN_FALL_DELAY_MS)) {
 323:Core/Src/tetris.c ****         return MIN_FALL_DELAY_MS;
 324:Core/Src/tetris.c ****     }
 325:Core/Src/tetris.c **** 
 326:Core/Src/tetris.c ****     return FALL_DELAY_MS - reduction;
 327:Core/Src/tetris.c **** }
