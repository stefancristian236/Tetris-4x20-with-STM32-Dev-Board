 227:Core/Src/tetris.c **** static void lcd_write_line(uint8_t row, const char *text) {
 228:Core/Src/tetris.c ****     lcd_put_cur(row, 0);
 229:Core/Src/tetris.c **** 
 230:Core/Src/tetris.c ****     for (uint8_t i = 0; i < 20; i++) {
 231:Core/Src/tetris.c ****         char ch = (text[i] != '\0') ? text[i] : ' ';
 232:Core/Src/tetris.c ****         lcd_send_data(ch);
 233:Core/Src/tetris.c ****         if (text[i] == '\0') {
 234:Core/Src/tetris.c ****             for (i = i + 1; i < 20; i++) {
 235:Core/Src/tetris.c ****                 lcd_send_data(' ');
 236:Core/Src/tetris.c ****             }
 237:Core/Src/tetris.c ****             break;
 238:Core/Src/tetris.c ****         }
 239:Core/Src/tetris.c ****     }
 240:Core/Src/tetris.c **** }
