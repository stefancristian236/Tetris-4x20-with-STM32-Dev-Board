  65:Core/Src/main.c **** //pwm citim din TIM2
  66:Core/Src/main.c **** void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
  67:Core/Src/main.c ****     if (htim->Instance == TIM2) {
  68:Core/Src/main.c ****         if (pwm_counter == 0) {
  69:Core/Src/main.c ****             if (duty_R > 0) HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_SET);
  70:Core/Src/main.c ****             if (duty_G > 0) HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_SET);
  71:Core/Src/main.c ****             if (duty_B > 0) HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_SET);
  72:Core/Src/main.c ****         }
  73:Core/Src/main.c **** 
  74:Core/Src/main.c ****         if (pwm_counter >= duty_R) HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_RESET);
  75:Core/Src/main.c ****         if (pwm_counter >= duty_G) HAL_GPIO_WritePin(GPIOB, GPIO_PIN_1, GPIO_PIN_RESET);
  76:Core/Src/main.c ****         if (pwm_counter >= duty_B) HAL_GPIO_WritePin(GPIOA, GPIO_PIN_8, GPIO_PIN_RESET);
  77:Core/Src/main.c **** 
  78:Core/Src/main.c ****         pwm_counter++;
  79:Core/Src/main.c ****         if (pwm_counter >= 100) {
  80:Core/Src/main.c ****             pwm_counter = 0;
  81:Core/Src/main.c ****         }
  82:Core/Src/main.c ****     }
  83:Core/Src/main.c **** }
