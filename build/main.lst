 179:Core/Src/main.c ****     MX_USB_DEVICE_Init();
 180:Core/Src/main.c ****     
 181:Core/Src/main.c ****     MX_TIM2_Init();
 182:Core/Src/main.c **** 
 183:Core/Src/main.c ****     HAL_TIM_Base_Start_IT(&htim2);
 184:Core/Src/main.c **** 
 185:Core/Src/main.c ****     printf("Code version %d.%d starting...\r\n", SW_VERSION / 10, SW_VERSION % 10);
 186:Core/Src/main.c ****     printf("Stare initiala: Albastru (R 0%%, G 0%%, B 100%%)\r\n");
 187:Core/Src/main.c **** 
 188:Core/Src/main.c ****     const char *text = "hello 23";
 189:Core/Src/main.c ****     morseBlink(text);
 190:Core/Src/main.c **** 
 191:Core/Src/main.c ****     HAL_UART_Receive_IT(&huart1, &rx_data, 1);
 192:Core/Src/main.c **** 
 193:Core/Src/main.c ****     while (1) {
 194:Core/Src/main.c ****         //daca flag-ul se seteaza facem automat secventa Morse
 195:Core/Src/main.c ****         if (play_morse_flag == 1) {
 196:Core/Src/main.c ****             printf("Playing Morse sequence...\r\n");
 197:Core/Src/main.c ****             morseBlink("hello 23");
 198:Core/Src/main.c **** 
 199:Core/Src/main.c ****             play_loop();
 200:Core/Src/main.c ****             play_morse_flag = 0;
 201:Core/Src/main.c ****         }
 202:Core/Src/main.c **** 
 203:Core/Src/main.c ****         //debouncer
 204:Core/Src/main.c ****         if (HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_RESET) {
ARM GAS  C:\Users\BOBESB~1\AppData\Local\Temp\ccVph0aU.s 			page 5


 205:Core/Src/main.c ****             HAL_Delay(25);
 206:Core/Src/main.c ****             if (HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_RESET) {
 207:Core/Src/main.c ****                 while (HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_RESET);
 208:Core/Src/main.c ****                 state++;
 209:Core/Src/main.c ****                 if (state > 4) {
 210:Core/Src/main.c ****                     state = 0;
 211:Core/Src/main.c ****                 }
 212:Core/Src/main.c ****                 //fsm
 213:Core/Src/main.c ****                 switch (state) {
 214:Core/Src/main.c ****                     case 0:
 215:Core/Src/main.c ****                         duty_R = 0; duty_G = 0; duty_B = 100;
 216:Core/Src/main.c ****                         break;
 217:Core/Src/main.c ****                     case 1:
 218:Core/Src/main.c ****                         duty_R = 80; duty_G = 50; duty_B = 0;
 219:Core/Src/main.c ****                         break;
 220:Core/Src/main.c ****                     case 2:
