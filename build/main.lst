  47:Core/Src/main.c **** //citim ce avem in rx, daca e Morse jucan else continuam sa citim
  48:Core/Src/main.c **** void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
  49:Core/Src/main.c ****     if (huart->Instance == USART1) {
  50:Core/Src/main.c ****         if (rx_data == '\n' || rx_data == '\r') {
  51:Core/Src/main.c ****             rx_buffer[rx_index] = '\0';
  52:Core/Src/main.c ****             if (strcmp(rx_buffer, "Morse") == 0) {
  53:Core/Src/main.c ****                 play_morse_flag = 1;
  54:Core/Src/main.c ****             }
  55:Core/Src/main.c ****             rx_index = 0;
  56:Core/Src/main.c ****         } else {
  57:Core/Src/main.c ****             if (rx_index < sizeof(rx_buffer) - 1) {
  58:Core/Src/main.c ****                 rx_buffer[rx_index++] = (char)rx_data;
  59:Core/Src/main.c ****             }
  60:Core/Src/main.c ****         }
  61:Core/Src/main.c ****         HAL_UART_Receive_IT(&huart1, &rx_data, 1);
  62:Core/Src/main.c ****     }
  63:Core/Src/main.c **** }
