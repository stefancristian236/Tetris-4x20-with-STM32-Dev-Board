  38:Core/Src/main.c **** TetrisCommand Read_Inputs() {
  39:Core/Src/main.c ****     // Aligned to PA1-PA4 based on your MX_GPIO_Init
  40:Core/Src/main.c ****     if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_1) == GPIO_PIN_RESET) return CMD_LEFT;
  41:Core/Src/main.c ****     if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_2) == GPIO_PIN_RESET) return CMD_RIGHT;
  42:Core/Src/main.c ****     if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_3) == GPIO_PIN_RESET) return CMD_ROTATE;
  43:Core/Src/main.c ****     if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_4) == GPIO_PIN_RESET) return CMD_DOWN;
  44:Core/Src/main.c ****     
  45:Core/Src/main.c ****     return CMD_NONE;
  46:Core/Src/main.c **** }
  47:Core/Src/main.c **** 
  48:Core/Src/main.c **** // Global variable to hold incoming UART character
  49:Core/Src/main.c **** uint8_t rx_data;
  50:Core/Src/main.c **** 
  51:Core/Src/main.c **** // Interrupt callback for standard UART (if you want keyboard input via PuTTY/TeraTerm)
  52:Core/Src/main.c **** void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
  53:Core/Src/main.c ****     if (huart->Instance == USART1) {
  54:Core/Src/main.c ****         if (rx_data == 'a' || rx_data == 'A') Tetris_Update(CMD_LEFT);
  55:Core/Src/main.c ****         if (rx_data == 'd' || rx_data == 'D') Tetris_Update(CMD_RIGHT);
  56:Core/Src/main.c ****         if (rx_data == 'w' || rx_data == 'W') Tetris_Update(CMD_ROTATE);
  57:Core/Src/main.c ****         if (rx_data == 's' || rx_data == 'S') Tetris_Update(CMD_DOWN);
  58:Core/Src/main.c ****         
  59:Core/Src/main.c ****         Tetris_DrawTerminal();
  60:Core/Src/main.c ****         Tetris_DrawLCD();
  61:Core/Src/main.c ****         
  62:Core/Src/main.c ****         // Listen for the next character
  63:Core/Src/main.c ****         HAL_UART_Receive_IT(&huart1, &rx_data, 1);
  64:Core/Src/main.c ****     }
  65:Core/Src/main.c **** }
