  28:Core/Src/main.c **** 
  29:Core/Src/main.c **** /*
  30:Core/Src/main.c ****  * CDC_Send — wraps CDC_Transmit_FS with a short busy-retry.
  31:Core/Src/main.c ****  *
  32:Core/Src/main.c ****  * The USB stack keeps an internal TX buffer.  If a previous transfer is still
  33:Core/Src/main.c ****  * in flight, CDC_Transmit_FS returns USBD_BUSY.  We retry for up to 10 ms
ARM GAS  C:\Users\crist\AppData\Local\Temp\ccUENW4r.s 			page 2


  34:Core/Src/main.c ****  * before giving up so we never block the main loop for long.
  35:Core/Src/main.c ****  */
  36:Core/Src/main.c **** static void UART_Send(const char *msg)
  37:Core/Src/main.c **** {
  38:Core/Src/main.c ****     HAL_UART_Transmit(&huart1,
  39:Core/Src/main.c ****                       (uint8_t *)msg,
  40:Core/Src/main.c ****                       strlen(msg),
  41:Core/Src/main.c ****                       HAL_MAX_DELAY);
  42:Core/Src/main.c **** }
  43:Core/Src/main.c **** /* USER CODE END 0 */
  44:Core/Src/main.c **** 
  45:Core/Src/main.c **** int main(void)
  46:Core/Src/main.c **** {
  47:Core/Src/main.c ****     /* MCU init ---------------------------------------------------------------*/
  48:Core/Src/main.c ****     HAL_Init();
  49:Core/Src/main.c ****     SystemClock_Config();
  50:Core/Src/main.c **** 
  51:Core/Src/main.c ****     MX_GPIO_Init();
  52:Core/Src/main.c ****     MX_USART1_UART_Init();
  53:Core/Src/main.c ****     MX_TIM2_Init();
  54:Core/Src/main.c ****     MX_I2C1_Init();
  55:Core/Src/main.c **** 
  56:Core/Src/main.c ****     /* USER CODE BEGIN 2 */
  57:Core/Src/main.c **** 
  58:Core/Src/main.c ****     /*
  59:Core/Src/main.c ****      * Give the USB host ~500 ms to enumerate the CDC device before we try
  60:Core/Src/main.c ****      * to transmit.  Without this, the first CDC_Send after power-on may be
  61:Core/Src/main.c ****      * dropped because the host hasn't opened the COM port yet.
  62:Core/Src/main.c ****      */
  63:Core/Src/main.c ****     HAL_Delay(500);
  64:Core/Src/main.c **** 
  65:Core/Src/main.c **** butt_Init();
  66:Core/Src/main.c **** 
  67:Core/Src/main.c **** UART_Send("Controller ready!\r\n");
  68:Core/Src/main.c **** 
  69:Core/Src/main.c ****     /* USER CODE END 2 */
  70:Core/Src/main.c **** 
  71:Core/Src/main.c ****     /* Infinite loop ----------------------------------------------------------*/
  72:Core/Src/main.c **** while (1)
  73:Core/Src/main.c **** {
  74:Core/Src/main.c ****     if (read_butt_Left())
  75:Core/Src/main.c ****         UART_Send("LEFT\r\n");
  76:Core/Src/main.c **** 
  77:Core/Src/main.c ****     if (read_butt_Right())
  78:Core/Src/main.c ****         UART_Send("RIGHT\r\n");
  79:Core/Src/main.c **** 
  80:Core/Src/main.c ****     if (read_butt_Rotate())
  81:Core/Src/main.c ****         UART_Send("ROTATE\r\n");
  82:Core/Src/main.c **** 
  83:Core/Src/main.c ****     if (read_butt_Drop())
  84:Core/Src/main.c ****         UART_Send("DROP\r\n");
  85:Core/Src/main.c ****     UART_Send(HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_1) ? "1\r\n" : "0\r\n");
  86:Core/Src/main.c ****     HAL_Delay(200);
  87:Core/Src/main.c **** 
  88:Core/Src/main.c ****     HAL_Delay(10);
  89:Core/Src/main.c **** }
  90:Core/Src/main.c **** }
