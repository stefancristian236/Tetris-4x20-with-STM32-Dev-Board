 170:Core/Src/main.c ****     HAL_TIM_Base_Start_IT(&htim2);
 171:Core/Src/main.c **** 
 172:Core/Src/main.c ****     printf("Code version %d.%d starting...\r\n", SW_VERSION / 10, SW_VERSION % 10);
 173:Core/Src/main.c ****     printf("Stare initiala: Albastru (R 0%%, G 0%%, B 100%%)\r\n");
 174:Core/Src/main.c **** 
 175:Core/Src/main.c ****     const char *text = "hello 23";
 176:Core/Src/main.c ****     morseBlink(text);
 177:Core/Src/main.c ****     // main loop
 178:Core/Src/main.c ****     //fsr
 179:Core/Src/main.c ****     while (1) {
 180:Core/Src/main.c ****         //debouncer
 181:Core/Src/main.c ****         if (HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_RESET) {
 182:Core/Src/main.c ****             HAL_Delay(25);
 183:Core/Src/main.c ****             if (HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_RESET) {
 184:Core/Src/main.c ****                 while (HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_RESET);
 185:Core/Src/main.c ****                 state++;
 186:Core/Src/main.c ****                 if (state > 4) {
 187:Core/Src/main.c ****                     state = 0;
 188:Core/Src/main.c ****                 }
 189:Core/Src/main.c **** 
 190:Core/Src/main.c ****                 //setare actori de umple si swtich prin code
 191:Core/Src/main.c ****                 switch (state) {
 192:Core/Src/main.c ****                     case 0: //albastru
 193:Core/Src/main.c ****                         duty_R = 0; duty_G = 0; duty_B = 100;
 194:Core/Src/main.c ****                         break;
 195:Core/Src/main.c **** 
 196:Core/Src/main.c ****                     case 1: //galben
 197:Core/Src/main.c ****                         duty_R = 80; duty_G = 50; duty_B = 0;
 198:Core/Src/main.c ****                         break;
 199:Core/Src/main.c **** 
 200:Core/Src/main.c ****                     case 2: //magenta
 201:Core/Src/main.c ****                         duty_R = 50; duty_G = 0; duty_B = 50;
 202:Core/Src/main.c ****                         break;
 203:Core/Src/main.c **** 
 204:Core/Src/main.c ****                     case 3: // stins
ARM GAS  C:\Users\crist\AppData\Local\Temp\ccrYGjzb.s 			page 5


 205:Core/Src/main.c ****                         duty_R = 0; duty_G = 0; duty_B = 0;
 206:Core/Src/main.c ****                         break;
 207:Core/Src/main.c ****                     case 4: // morse code
 208:Core/Src/main.c ****                         //red pentru dot 1t,  green pentru dash 3t, spatiu 4t 
 209:Core/Src/main.c ****                         play_loop();
 210:Core/Src/main.c ****                         break;  
 211:Core/Src/main.c ****                     break;
 212:Core/Src/main.c ****                 }
 213:Core/Src/main.c **** 
 214:Core/Src/main.c ****                 //tentativa de a printa pe serial monitor
