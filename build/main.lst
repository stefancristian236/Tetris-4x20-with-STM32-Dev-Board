  27:Core/Src/main.c **** // Helper to load Tetris block graphics into the LCD memory
  28:Core/Src/main.c **** void load_custom_chars(void) {
  29:Core/Src/main.c ****     uint8_t top[8]  = {0x1F, 0x1F, 0x1F, 0x1F, 0x00, 0x00, 0x00, 0x00};
  30:Core/Src/main.c ****     uint8_t bot[8]  = {0x00, 0x00, 0x00, 0x00, 0x1F, 0x1F, 0x1F, 0x1F};
  31:Core/Src/main.c ****     uint8_t full[8] = {0x1F, 0x1F, 0x1F, 0x1F, 0x1F, 0x1F, 0x1F, 0x1F};
  32:Core/Src/main.c **** 
  33:Core/Src/main.c ****     lcd_send_cmd(0x40 + (1 * 8)); for(int i=0; i<8; i++) lcd_send_data(top[i]);
ARM GAS  C:\Users\crist\AppData\Local\Temp\ccgSDiWx.s 			page 2


  34:Core/Src/main.c ****     lcd_send_cmd(0x40 + (2 * 8)); for(int i=0; i<8; i++) lcd_send_data(bot[i]);
  35:Core/Src/main.c ****     lcd_send_cmd(0x40 + (3 * 8)); for(int i=0; i<8; i++) lcd_send_data(full[i]);
  36:Core/Src/main.c **** }
