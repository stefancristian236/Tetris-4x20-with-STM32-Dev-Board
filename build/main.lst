 228:Core/Src/main.c ****                         break;  
 229:Core/Src/main.c ****                 }
 230:Core/Src/main.c **** 
 231:Core/Src/main.c ****                 printf("R %d%%, G %d%%, B %d%%\r\n", duty_R, duty_G, duty_B);
 232:Core/Src/main.c ****             }
 233:Core/Src/main.c ****         }
