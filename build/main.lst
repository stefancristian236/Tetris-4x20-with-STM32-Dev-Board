 100:Core/Src/main.c **** //logica pentru morse
 101:Core/Src/main.c **** void morseBlink(const char* str) {
 102:Core/Src/main.c ****     sq_len = 0;
 103:Core/Src/main.c ****     for (int i = 0; str[i] != '\0'; ++i) {
 104:Core/Src/main.c ****         char c = str[i];
 105:Core/Src/main.c **** 
 106:Core/Src/main.c ****         if (c == ' ') {
 107:Core/Src/main.c ****             command(4 * clock_period, 0);
 108:Core/Src/main.c ****             continue;
 109:Core/Src/main.c ****         }
 110:Core/Src/main.c **** 
 111:Core/Src/main.c ****         const char* code = "";
 112:Core/Src/main.c ****         for (int j = 0; j < 6; j++) {
 113:Core/Src/main.c ****             if (alphabet[j].letter == c) {
 114:Core/Src/main.c ****                 code = alphabet[j].code;
 115:Core/Src/main.c ****                 break;
 116:Core/Src/main.c ****             }
 117:Core/Src/main.c ****         }
 118:Core/Src/main.c **** 
 119:Core/Src/main.c ****         for (int k = 0; code[k] != '\0'; ++k) {
 120:Core/Src/main.c ****             if (code[k] == '.') {
 121:Core/Src/main.c ****                 command(clock_period, 1);
 122:Core/Src/main.c ****             }else if (code[k] == '-') {
 123:Core/Src/main.c ****                 command(3 * clock_period, 2);
 124:Core/Src/main.c ****             }
 125:Core/Src/main.c **** 
 126:Core/Src/main.c ****             command(clock_period, 0);
 127:Core/Src/main.c ****         }
 128:Core/Src/main.c ****     }
 129:Core/Src/main.c **** }
 130:Core/Src/main.c **** 
 131:Core/Src/main.c **** void play_loop() {
 132:Core/Src/main.c ****     for (int i = 0; i < sq_len; ++i) {
 133:Core/Src/main.c ****         switch (seq[i].color_mode){
 134:Core/Src/main.c ****             case 1:
 135:Core/Src/main.c ****                 duty_R = 100;
 136:Core/Src/main.c ****                 duty_G = 0;
 137:Core/Src/main.c ****                 duty_B = 0;
 138:Core/Src/main.c ****             break;
 139:Core/Src/main.c ****             case 2:
 140:Core/Src/main.c ****                 duty_R = 0;
 141:Core/Src/main.c ****                 duty_G = 100;
 142:Core/Src/main.c ****                 duty_B = 0;
 143:Core/Src/main.c ****             break;
 144:Core/Src/main.c ****             case 0:
 145:Core/Src/main.c ****                 duty_R = 0;
 146:Core/Src/main.c ****                 duty_G = 0;
 147:Core/Src/main.c ****                 duty_B = 0;
ARM GAS  C:\Users\crist\AppData\Local\Temp\ccrYGjzb.s 			page 4


 148:Core/Src/main.c ****             break;
 149:Core/Src/main.c ****         break;
 150:Core/Src/main.c ****         }
 151:Core/Src/main.c ****         HAL_Delay(seq[i].duration);
 152:Core/Src/main.c ****     }
 153:Core/Src/main.c ****     duty_R = 33;
 154:Core/Src/main.c ****     duty_G = 33;
 155:Core/Src/main.c ****     duty_B = 34;
 156:Core/Src/main.c **** }
