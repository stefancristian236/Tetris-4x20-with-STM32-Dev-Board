 103:Core/Src/main.c **** } MorseCommand;
 104:Core/Src/main.c **** 
 105:Core/Src/main.c **** MorseCommand seq[150];
 106:Core/Src/main.c **** int sq_len = 0;
 107:Core/Src/main.c **** 
 108:Core/Src/main.c **** void command(uint16_t dur, uint8_t color) {
 109:Core/Src/main.c ****     seq[sq_len].duration = dur;
 110:Core/Src/main.c ****     seq[sq_len].color_mode = color;
 111:Core/Src/main.c ****     sq_len++;
 112:Core/Src/main.c **** }
 113:Core/Src/main.c **** 
 114:Core/Src/main.c **** //explicat mai jos la play_loop()
 115:Core/Src/main.c **** void morseBlink(const char* str) {
 116:Core/Src/main.c ****     sq_len = 0;
 117:Core/Src/main.c ****     for (int i = 0; str[i] != '\0'; ++i) {
 118:Core/Src/main.c ****         char c = str[i];
 119:Core/Src/main.c **** 
 120:Core/Src/main.c ****         if (c == ' ') {
 121:Core/Src/main.c ****             command(4 * clock_period, 0);
 122:Core/Src/main.c ****             continue;
 123:Core/Src/main.c ****         }
 124:Core/Src/main.c **** 
 125:Core/Src/main.c ****         const char* code = "";
 126:Core/Src/main.c ****         for (int j = 0; j < 6; j++) {
 127:Core/Src/main.c ****             if (alphabet[j].letter == c) {
 128:Core/Src/main.c ****                 code = alphabet[j].code;
 129:Core/Src/main.c ****                 break;
 130:Core/Src/main.c ****             }
 131:Core/Src/main.c ****         }
 132:Core/Src/main.c **** 
 133:Core/Src/main.c ****         for (int k = 0; code[k] != '\0'; ++k) {
 134:Core/Src/main.c ****             if (code[k] == '.') {
 135:Core/Src/main.c ****                 command(clock_period, 1);
 136:Core/Src/main.c ****             } else if (code[k] == '-') {
 137:Core/Src/main.c ****                 command(3 * clock_period, 2);
 138:Core/Src/main.c ****             }
 139:Core/Src/main.c **** 
 140:Core/Src/main.c ****             command(clock_period, 0);
 141:Core/Src/main.c ****         }
 142:Core/Src/main.c ****     }
 143:Core/Src/main.c **** }
 144:Core/Src/main.c **** 
 145:Core/Src/main.c **** //main loop, face switch intre culorile pentru cod
 146:Core/Src/main.c **** //red 1t dot, green 3t dash, spatiu 4t  0 0 0
 147:Core/Src/main.c **** void play_loop() {
ARM GAS  C:\Users\BOBESB~1\AppData\Local\Temp\ccVph0aU.s 			page 4


 148:Core/Src/main.c ****     for (int i = 0; i < sq_len; ++i) {
 149:Core/Src/main.c ****         switch (seq[i].color_mode){
 150:Core/Src/main.c ****             case 1:
 151:Core/Src/main.c ****                 duty_R = 100;
 152:Core/Src/main.c ****                 duty_G = 0;
 153:Core/Src/main.c ****                 duty_B = 0;
 154:Core/Src/main.c ****             break;
 155:Core/Src/main.c ****             case 2:
 156:Core/Src/main.c ****                 duty_R = 0;
 157:Core/Src/main.c ****                 duty_G = 100;
 158:Core/Src/main.c ****                 duty_B = 0;
 159:Core/Src/main.c ****             break;
 160:Core/Src/main.c ****             case 0:
 161:Core/Src/main.c ****                 duty_R = 0;
 162:Core/Src/main.c ****                 duty_G = 0;
 163:Core/Src/main.c ****                 duty_B = 0;
 164:Core/Src/main.c ****             break;
 165:Core/Src/main.c ****         break;
 166:Core/Src/main.c ****         }
 167:Core/Src/main.c ****         HAL_Delay(seq[i].duration);
 168:Core/Src/main.c ****     }
 169:Core/Src/main.c ****     duty_R = 33;
 170:Core/Src/main.c ****     duty_G = 33;
 171:Core/Src/main.c ****     duty_B = 34;
 172:Core/Src/main.c **** }
