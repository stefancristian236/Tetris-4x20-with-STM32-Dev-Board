  76:Core/Src/main.c ****   /* USER CODE BEGIN 2 */
  77:Core/Src/main.c ****   lcd_init();            // Boot up the screen
  78:Core/Src/main.c ****   lcd_clear();
  79:Core/Src/main.c ****   load_custom_chars();   // Load Tetris block shapes
  80:Core/Src/main.c ****   
  81:Core/Src/main.c ****   Tetris_Init();         // Start the game logic
  82:Core/Src/main.c ****   last_fall_time = HAL_GetTick();
  83:Core/Src/main.c ****   
  84:Core/Src/main.c ****   // Start listening for UART keyboard inputs (optional)
  85:Core/Src/main.c ****   HAL_UART_Receive_IT(&huart1, &rx_data, 1);
  86:Core/Src/main.c ****   /* USER CODE END 2 */
  87:Core/Src/main.c **** 
  88:Core/Src/main.c ****   while (1)
  89:Core/Src/main.c ****   {
  90:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
ARM GAS  C:\Users\crist\AppData\Local\Temp\ccgSDiWx.s 			page 3


  91:Core/Src/main.c ****     // --- HEARTBEAT BLINK ---
  92:Core/Src/main.c ****     HAL_GPIO_TogglePin(GPIOC, GPIO_PIN_13); 
  93:Core/Src/main.c **** 
  94:Core/Src/main.c ****     TetrisCommand input = Read_Inputs();
  95:Core/Src/main.c ****     
  96:Core/Src/main.c ****     if (input != CMD_NONE) {
  97:Core/Src/main.c ****         Tetris_Update(input);
  98:Core/Src/main.c ****         Tetris_DrawTerminal();
  99:Core/Src/main.c ****         Tetris_DrawLCD();
 100:Core/Src/main.c ****         HAL_Delay(150); // Debounce
 101:Core/Src/main.c ****     }
 102:Core/Src/main.c **** 
 103:Core/Src/main.c ****     // Auto-fall (Gravity)
 104:Core/Src/main.c ****     if (HAL_GetTick() - last_fall_time >= FALL_DELAY_MS) {
 105:Core/Src/main.c ****         Tetris_Update(CMD_DOWN);
 106:Core/Src/main.c ****         Tetris_DrawTerminal();
 107:Core/Src/main.c ****         Tetris_DrawLCD();
 108:Core/Src/main.c ****         last_fall_time = HAL_GetTick();
 109:Core/Src/main.c ****     }
 110:Core/Src/main.c ****     
 111:Core/Src/main.c ****     // Tiny delay to make the LED blink visible and not burn 100% CPU
 112:Core/Src/main.c ****     HAL_Delay(50);
 113:Core/Src/main.c ****     /* USER CODE END 3 */
 114:Core/Src/main.c ****   }
 115:Core/Src/main.c **** }
